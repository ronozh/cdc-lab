{
  "name": "snowflake-transaction-sink",
  "config": {
    "connector.class": "com.snowflake.kafka.connector.SnowflakeStreamingSinkConnector",
    "tasks.max": "1",
    "topics": "cdc.public.transaction",
    "snowflake.topic2table.map": "cdc.public.transaction:TRANSACTION_RAW",
    "snowflake.url.name": "${env:SF_URL}",
    "snowflake.user.name": "KAFKA_SVC",
    "snowflake.private.key": "${env:SF_PRIVATE_KEY}",
    "snowflake.role.name": "CDC_INGEST",
    "snowflake.database.name": "CDC_LAB",
    "snowflake.schema.name": "BRONZE",
    "snowflake.enable.schematization": "false",
    "snowflake.streaming.validate.compatibility.with.classic": "false",
    "behavior.on.null.values": "IGNORE",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false"
  }
}
