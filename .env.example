PG_HOST=localhost
PG_PORT=5432
PG_DB=shop
PG_USER=cdc
PG_PASSWORD=change-me
GEN_INTERVAL_SEC=10
# Snowflake sink (phase 5): account endpoint + KAFKA_SVC private key body (one line, no BEGIN/END)
SF_URL=<ORG>-<ACCOUNT>.snowflakecomputing.com
SF_PRIVATE_KEY=

# S3 sink (phase 6): from `scripts/tf.sh core output` (bucket, access key, -raw secret)
S3_RAW_BUCKET=
S3_SINK_ACCESS_KEY_ID=
S3_SINK_SECRET_ACCESS_KEY=

# Snowflake account identifier <org>-<account>: used by Terraform, dbt and the readers
SNOWFLAKE_ACCOUNT=

# Optional (defaults in scripts/_env.sh)
# AWS_REGION=ap-southeast-2
# HORIZON_KEY_FILE=~/.snowflake/keys/cdclab_reader_svc.p8
# SNOW_CONNECTION=cdclab_terraform
